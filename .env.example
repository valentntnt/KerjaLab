# Salin file ini menjadi .env lalu sesuaikan:  cp .env.example .env
# JANGAN commit file .env. Semua nilai di bawah adalah contoh/dummy.

# --- Database (PostgreSQL) ---
POSTGRES_USER=kerjalab
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=kerjalab

# --- Backend ---
# Rahasia penandatangan token login. Isi string acak panjang (mis. `openssl rand -hex 32`).
JWT_SECRET=ganti_dengan_string_acak_panjang
# dev    = login tanpa Google (nama + email dummy), untuk demo/penilaian lokal
# google = login Google OAuth (wajib isi GOOGLE_CLIENT_ID)
AUTH_MODE=dev
GOOGLE_CLIENT_ID=
APP_TZ=Asia/Jakarta

# --- Port di localhost ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
ADMINER_PORT=8080
